# Configuración de Wuolah PDF Helper
MAX_PDF_SIZE_MB=100
JOB_TTL_MINUTES=30
BROWSER_HEADLESS=false
TEMP_DIR=/tmp/wuolah-pdf
BROWSER_TIMEOUT_SECONDS=90
DOWNLOAD_TIMEOUT_SECONDS=60
PORT=8000

# Token opcional para uso en Docker o servidores sin interfaz gráfica
# Si se define, la descarga directa funciona inmediatamente sin necesidad de navegador
WUOLAH_TOKEN=
